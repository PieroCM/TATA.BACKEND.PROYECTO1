<?xml version="1.0" encoding="utf-8"?>
<!-- Configuración de cobertura (Coverlet). Uso:
     dotnet test TATA.BACKEND.PROYECTO1.Tests -settings coverlet.runsettings -collect:"XPlat Code Coverage" -->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat code coverage">
        <Configuration>
          <Format>cobertura,opencover</Format>
          <!-- Código generado por EF Core: no tiene lógica propia que probar -->
          <ExcludeByFile>**/Migrations/*.cs</ExcludeByFile>
          <ExcludeByAttribute>GeneratedCodeAttribute</ExcludeByAttribute>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
